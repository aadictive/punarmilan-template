frontend-tickets/src/assets/
generated/

# Environment files (deploy writes .env.production from the stack outputs)
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS / editor / local tooling
.DS_Store
.vscode/
.claude/

# Local secrets scratch files - keep them out of git no matter what
*.secret
*.secrets
secrets.env
*.pem
*.zip
