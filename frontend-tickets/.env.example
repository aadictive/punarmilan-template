# You normally never touch this file: scripts/deploy.sh (and the GitHub Action)
# write frontend-tickets/.env.production for you from the deployed stack's
# outputs. It is only listed here so you can see what the site needs.
#
# VITE_REGISTER_ENDPOINT=https://<function-url>.lambda-url.<region>.on.aws/
# VITE_CONFIG_ENDPOINT=...
# VITE_CHECKOUT_ENDPOINT=...
# VITE_ADMIN_ENDPOINT=...
# VITE_MARK_PAID_ENDPOINT=...
# VITE_UNMARK_PAID_ENDPOINT=...
# VITE_SELECT_METHOD_ENDPOINT=...
# VITE_SEND_INSTRUCTIONS_ENDPOINT=...
# VITE_SEND_REMINDER_ENDPOINT=...
# VITE_TRACK_VIEW_ENDPOINT=...
# VITE_CHECKIN_ENDPOINT=...
# VITE_ADMIN_CHECKIN_ENDPOINT=...
# VITE_ADMIN_SEND_EMAIL_ENDPOINT=...
# VITE_DECLINE_ENDPOINT=...
